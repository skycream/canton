// Canton Bootstrap Script
// Initializes the domain, connects participant, uploads DARs, and creates parties/users.

// ─── Step 1: Initialize the domain ───
val domainManager = domain_managers.domain_manager1
domainManager.setup.bootstrap_domain(
  sequencers.sequencer1,
  Seq(mediators.mediator1)
)

// ─── Step 2: Connect participant to domain ───
val participant = participants.participant1
participant.domains.connect_local(sequencers.sequencer1, alias = "mydomain")

// Wait for the participant to be active on the domain
utils.retry_until_true {
  participant.domains.active("mydomain")
}

// ─── Step 3: Upload DAR ───
val darPath = sys.env.getOrElse("CANTON_DAR_PATH", "../.daml/dist/asset-transfer-0.1.0.dar")
participant.dars.upload(darPath)

// ─── Step 4: Create parties ───
val alice = participant.parties.enable("Alice")
val bob = participant.parties.enable("Bob")
val charlie = participant.parties.enable("Charlie")

// ─── Step 5: Create users and assign primary parties ───
participant.ledger_api.users.create(
  id = "alice",
  actAs = Set(alice),
  primaryParty = alice,
  readAs = Set.empty
)

participant.ledger_api.users.create(
  id = "bob",
  actAs = Set(bob),
  primaryParty = bob,
  readAs = Set.empty
)

participant.ledger_api.users.create(
  id = "charlie",
  actAs = Set(charlie),
  primaryParty = charlie,
  readAs = Set.empty
)

// ─── Step 6: Create initial assets via Daml Script (optional) ───
// If you want to initialize assets, run:
//   daml script --dar ${darPath} --script-name Setup:setup \
//     --ledger-host localhost --ledger-port 5011 --access-token-file token.jwt
println("Bootstrap completed successfully.")
println(s"  Alice:   ${alice}")
println(s"  Bob:     ${bob}")
println(s"  Charlie: ${charlie}")
