# =============================================================================
# Canton Global Synchronizer (DevNet) - Splice Validator Configuration
# =============================================================================
# Copy to .env and fill in your values before running setup-validator.sh

# --- Splice Validator Node ---------------------------------------------------
# Splice release version (must match DevNet migration ID)
SPLICE_VERSION=0.5.10
SPLICE_MIGRATION_ID=1

# Your validator identity (choose a unique name)
VALIDATOR_PARTY_HINT=your-org-name
VALIDATOR_WALLET_USER=wallet-user

# --- DevNet SV Sponsor -------------------------------------------------------
# Super Validator that sponsors your onboarding
SV_SPONSOR_URL=https://sv.sv-1.dev.global.canton.network.digitalasset.com

# --- Onboarding Secret -------------------------------------------------------
# Obtained via DevNet API (1-hour TTL) - setup-validator.sh fetches automatically
# ONBOARDING_SECRET=  (auto-populated by setup-validator.sh)

# --- Database (Splice-managed PostgreSQL) ------------------------------------
POSTGRES_USER=canton
POSTGRES_PASSWORD=supersecret

# --- Network Access -----------------------------------------------------------
# DevNet requires VPN or IP whitelist - contact your SV sponsor
# VALIDATOR_PUBLIC_URL=https://your-validator.example.com

# --- Ledger API (exposed by Splice nginx proxy) ------------------------------
LEDGER_API_HOST=localhost
LEDGER_API_PORT=5011

# --- Monitoring ---------------------------------------------------------------
VALIDATOR_METRICS_PORT=9000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Asset Transfer UI --------------------------------------------------------
REACT_APP_ENV=production
REACT_APP_LEDGER_URL=http://localhost:5011
REACT_APP_AUTH_URL=
REACT_APP_AUTH_CLIENT_ID=canton-ui

# --- DAR Path -----------------------------------------------------------------
DAR_PATH=../.daml/dist/asset-transfer-0.1.0.dar
