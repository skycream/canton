-- Test: Consumer claims timeout refund after deadline
testTimeoutClaim : Script ()
testTimeoutClaim = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0

  let sla = SLATerms with maxLatencyMs = 5000, penaltyRate = 0.10
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 10.0, slaTerms = sla, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 10.0, estimatedTimeMs = 3000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  -- deadline = t0 + 5s. Claim at t1 = t0+10s (after deadline)
  refundCid <- submit alice do exerciseCmd escrow ClaimTimeout with claimTime = t1

  Some coin <- queryContractId alice refundCid
  assertMsg "Full refund on timeout" (coin.amount == 10.0)
  return ()

-- Test: Consumer cannot claim timeout before deadline
testTimeoutClaimTooEarly : Script ()
testTimeoutClaimTooEarly = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0

  -- 60 second SLA
  let sla = SLATerms with maxLatencyMs = 60000, penaltyRate = 0.10
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 10.0, slaTerms = sla, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 10.0, estimatedTimeMs = 3000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  -- deadline = t0 + 60s. Claim at t1 = t0+10s (BEFORE deadline) — must fail
  submitMustFail alice do exerciseCmd escrow ClaimTimeout with claimTime = t1

  return ()

-- ========== Phase 2: Arbiter Dispute Resolution Tests ==========

-- Helper: setup escrow, deliver, dispute, and escalate to arbiter
setupEscalatedDispute : Script (Party, Party, Party, ContractId ArbitratedDispute)
setupEscalatedDispute = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  arbiter <- allocateParty "Arbiter"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 10.0, slaTerms = defaultSLA, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 10.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "hash", resultUrl = "url", deliveredAt = t1
  dispute <- submit alice do exerciseCmd review Dispute with reason = "Bad quality", disputedAt = t1
  arbDispute <- submit alice do exerciseCmd dispute EscalateToArbiter with arbiter
  return (alice, bob, arbiter, arbDispute)

-- Test: Arbiter rules for consumer (full refund)
testArbiterRulesForConsumer : Script ()
testArbiterRulesForConsumer = script do
  (alice, bob, arbiter, arbDispute) <- setupEscalatedDispute
  refundCid <- submitMulti [arbiter] [alice, bob] do exerciseCmd arbDispute RuleForConsumer
  Some coin <- queryContractId alice refundCid
  assertMsg "Alice gets full refund" (coin.amount == 10.0)
  return ()

-- Test: Arbiter rules for provider (full payment)
testArbiterRulesForProvider : Script ()
testArbiterRulesForProvider = script do
  (alice, bob, arbiter, arbDispute) <- setupEscalatedDispute
  paymentCid <- submitMulti [arbiter] [alice, bob] do exerciseCmd arbDispute RuleForProvider
  Some coin <- queryContractId bob paymentCid
  assertMsg "Bob gets full payment" (coin.amount == 10.0)
  return ()

-- Test: Arbiter splits funds (60/40)
testArbiterSplitRuling : Script ()
testArbiterSplitRuling = script do
  (alice, bob, arbiter, arbDispute) <- setupEscalatedDispute
  (consumerCid, providerCid) <- submitMulti [arbiter] [alice, bob] do
    exerciseCmd arbDispute SplitRuling with consumerAmount = 6.0
  Some consumerCoin <- queryContractId alice consumerCid
  assertMsg "Alice gets 6.0" (consumerCoin.amount == 6.0)
  Some providerCoin <- queryContractId bob providerCid
  assertMsg "Bob gets 4.0" (providerCoin.amount == 4.0)
  return ()

-- Test: Both parties can submit evidence
testSubmitEvidence : Script ()
testSubmitEvidence = script do
  (alice, bob, arbiter, arbDispute) <- setupEscalatedDispute

  arbDispute2 <- submit alice do
    exerciseCmd arbDispute SubmitEvidence with newEvidence = "Screenshot of bad output", submitter = alice
  arbDispute3 <- submit bob do
    exerciseCmd arbDispute2 SubmitEvidence with newEvidence = "Logs showing correct processing", submitter = bob

  Some d <- queryContractId alice arbDispute3
  assertMsg "Two pieces of evidence" (length d.evidence == 2)
  return ()

-- Test: Third party cannot escalate (only consumer can)
testThirdPartyCannotEscalate : Script ()
testThirdPartyCannotEscalate = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  charlie <- allocateParty "Charlie"
  arbiter <- allocateParty "Arbiter"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 10.0, slaTerms = defaultSLA, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 10.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "hash", resultUrl = "url", deliveredAt = t1
  dispute <- submit alice do exerciseCmd review Dispute with reason = "Bad", disputedAt = t1

  -- Charlie (third party) cannot escalate
  submitMustFail charlie do exerciseCmd dispute EscalateToArbiter with arbiter

  -- Bob (provider) cannot escalate — only consumer can
  submitMustFail bob do exerciseCmd dispute EscalateToArbiter with arbiter

  return ()

-- ========== Phase 3: Bidirectional Reputation Tests ==========

-- Test: Both parties rate after settlement
testBidirectionalRating : Script ()
testBidirectionalRating = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 10.0, slaTerms = defaultSLA, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 10.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "hash", resultUrl = "url", deliveredAt = t1

  -- Consumer rates provider via ApproveAndPay
  (_, consumerRating) <- submit alice do
    exerciseCmd review ApproveAndPay with consumerRating = 5, consumerComment = "Excellent"

  -- Provider receives a RatingInvitation to rate consumer
  invitations <- query @RatingInvitation bob
  assertMsg "Provider has invitation" (length invitations == 1)

  let (invCid, inv) = headNote "invitation" invitations
  assertMsg "Provider is rater" (inv.rater == bob)
  assertMsg "Consumer is rated" (inv.rated == alice)

  -- Provider submits rating
  providerRating <- submit bob do
    exerciseCmd invCid SubmitRating with score = 4, comment = "Good client"

  Some r <- queryContractId bob providerRating
  assertMsg "Provider rated consumer" (r.rated == alice)
  assertMsg "Role is provider" (r.role == "provider")
  return ()

-- Test: Provider declines rating invitation
testProviderDeclinesRating : Script ()
testProviderDeclinesRating = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 10.0, slaTerms = defaultSLA, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 10.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "hash", resultUrl = "url", deliveredAt = t1
  _ <- submit alice do exerciseCmd review ApproveAndPay with consumerRating = 5, consumerComment = "Good"

  invitations <- query @RatingInvitation bob
  let (invCid, _) = headNote "invitation" invitations

  -- Provider declines
  submit bob do exerciseCmd invCid DeclineRating

  -- No more invitations
  invitations2 <- query @RatingInvitation bob
  assertMsg "No invitations left" (null invitations2)
  return ()

