-- Test: Escrow cancellation (with locked coin refund)
testCancelEscrow : Script ()
testCancelEscrow = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 10.0

  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "image-gen", params = "{}"
      maxPrice = 5.0, slaTerms = defaultSLA, feeConfig = None

  offer <- submit bob do
    exerciseCmd request MakeOffer with price = 2.0, estimatedTimeMs = 10000

  escrow <- submit alice do
    exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  refund <- submit alice do exerciseCmd escrow CancelEscrow

  Some coin <- queryContractId alice refund
  assertMsg "Refund is 2.0" (coin.amount == 2.0)

  allCoins <- query @CAPCoin alice
  let total = foldl (\acc (_, c) -> acc + c.amount) 0.0 allCoins
  assertMsg "Alice has 10.0 total" (total == 10.0)
  return ()

-- Test: Dispute resolution (provider concedes)
testDispute : Script ()
testDispute = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 5.0

  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "translation"
      params = "{\"text\": \"Hello\"}"
      maxPrice = 1.0, slaTerms = defaultSLA, feeConfig = None

  offer <- submit bob do
    exerciseCmd request MakeOffer with price = 0.50, estimatedTimeMs = 3000

  escrow <- submit alice do
    exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  review <- submit bob do
    exerciseCmd escrow Deliver with
      resultHash = "sha256:bad_result"
      resultUrl = "https://results.cap/bad"
      deliveredAt = t1

  dispute <- submit alice do
    exerciseCmd review Dispute with reason = "Translation quality is unacceptable", disputedAt = t1

  refund <- submit bob do exerciseCmd dispute ResolveForConsumer

  Some coin <- queryContractId alice refund
  assertMsg "Alice gets full refund" (coin.amount == 0.50)
  return ()

