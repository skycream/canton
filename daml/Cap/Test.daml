-- Test: Token split
testTokenSplit : Script ()
testTokenSplit = script do
  alice <- allocateParty "Alice"

  coin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 100.0

  (coin1, coin2) <- submit alice do
    exerciseCmd coin Split with splitAmount = 30.0

  Some c1 <- queryContractId alice coin1
  Some c2 <- queryContractId alice coin2
  assertMsg "Split 1 = 30" (c1.amount == 30.0)
  assertMsg "Split 2 = 70" (c2.amount == 70.0)
  return ()

-- Test: Agent profile update
testProfileUpdate : Script ()
testProfileUpdate = script do
  registry <- allocateParty "Registry"
  alice <- allocateParty "Alice"

  submit alice do
    createCmd AgentProfile with
      registry, agent = alice
      name = "Old Name", description = "Old"
      capabilities = ["a"], endpoint = "http://old"

  submit alice do
    exerciseByKeyCmd @AgentProfile alice UpdateProfile with
      newName = "New Name"
      newDescription = "New"
      newCapabilities = ["a", "b", "c"]
      newEndpoint = "http://new"

  profiles <- query @AgentProfile alice
  let (_, p) = headNote "updated" profiles
  assertMsg "Name updated" (p.name == "New Name")
  assertMsg "Caps updated" (length p.capabilities == 3)
  return ()

-- Test: Token transfer (propose-accept)
testTokenTransfer : Script ()
testTokenTransfer = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  coin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 50.0

  proposal <- submit alice do
    exerciseCmd coin ProposeTransfer with receiver = bob

  bobCoin <- submit bob do
    exerciseCmd proposal AcceptTransfer

  Some c <- queryContractId bob bobCoin
  assertMsg "Bob owns the coin" (c.owner == bob)
  assertMsg "Amount is 50" (c.amount == 50.0)

  aliceCoins <- query @CAPCoin alice
  assertMsg "Alice has no coins" (null aliceCoins)
  return ()

-- Test: Token merge
testTokenMerge : Script ()
testTokenMerge = script do
  alice <- allocateParty "Alice"

  coin1 <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 30.0
  coin2 <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 70.0

  merged <- submit alice do
    exerciseCmd coin1 Merge with otherCid = coin2

  Some c <- queryContractId alice merged
  assertMsg "Merged amount is 100" (c.amount == 100.0)

  allCoins <- query @CAPCoin alice
  assertMsg "Only one coin left" (length allCoins == 1)
  return ()

-- ========== New CIP-0056 Token Standard Tests ==========

-- Test: Lock and refund basic flow
testLockAndRefund : Script ()
testLockAndRefund = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  coin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 25.0

  lockedCid <- submit alice do
    exerciseCmd coin Lock with beneficiary = bob

  -- Verify locked coin exists
  Some locked <- queryContractId alice lockedCid
  assertMsg "Original owner is alice" (locked.originalOwner == alice)
  assertMsg "Beneficiary is bob" (locked.beneficiary == bob)
  assertMsg "Amount is 25" (locked.amount == 25.0)

  -- Refund (only originalOwner needed)
  refundCid <- submit alice do
    exerciseCmd lockedCid Refund

  Some refund <- queryContractId alice refundCid
  assertMsg "Refund owner is alice" (refund.owner == alice)
  assertMsg "Refund amount is 25" (refund.amount == 25.0)
  return ()

-- Test: Lock and release to beneficiary (requires both parties)
testLockAndRelease : Script ()
testLockAndRelease = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  coin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 15.0

  lockedCid <- submit alice do
    exerciseCmd coin Lock with beneficiary = bob

  -- Release requires both originalOwner and beneficiary
  paymentCid <- submitMulti [alice, bob] [] do
    exerciseCmd lockedCid ReleaseToBeneficiary

  Some payment <- queryContractId bob paymentCid
  assertMsg "Payment owner is bob" (payment.owner == bob)
  assertMsg "Payment amount is 15" (payment.amount == 15.0)

  -- Alice no longer has coins
  aliceCoins <- query @CAPCoin alice
  assertMsg "Alice has no coins" (null aliceCoins)
  return ()

-- Test: Beneficiary alone cannot release locked coin
testBeneficiaryCannotRelease : Script ()
testBeneficiaryCannotRelease = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  coin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 10.0

  lockedCid <- submit alice do
    exerciseCmd coin Lock with beneficiary = bob

  -- Bob (beneficiary) alone cannot release
  submitMustFail bob do
    exerciseCmd lockedCid ReleaseToBeneficiary

  -- Locked coin still exists
  Some locked <- queryContractId alice lockedCid
  assertMsg "Still locked" (locked.amount == 10.0)
  return ()

-- Test: CAPCoin implements Holding interface (CIP-0056 query)
testHoldingInterface : Script ()
testHoldingInterface = script do
  alice <- allocateParty "Alice"

  _coin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 42.0

  holdings <- queryInterface @Holding alice
  assertMsg "One holding" (length holdings == 1)
  let (_, Some view) = headNote "holding" holdings
  assertMsg "Owner matches" (view.owner == alice)
  assertMsg "Amount matches" (view.amount == 42.0)
  return ()

-- Test: Provider abandon with locked coin refund
testAbandonWithLockedCoin : Script ()
testAbandonWithLockedCoin = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 20.0

  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 5.0, slaTerms = defaultSLA, feeConfig = None

  offer <- submit bob do
    exerciseCmd request MakeOffer with price = 3.0, estimatedTimeMs = 5000

  escrow <- submit alice do
    exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  -- Provider abandons → consumer gets refund via locked coin
  refundCid <- submit bob do
    exerciseCmd escrow AbandonEscrow

  Some refund <- queryContractId alice refundCid
  assertMsg "Refund is 3.0" (refund.amount == 3.0)

  allCoins <- query @CAPCoin alice
  let total = foldl (\acc (_, c) -> acc + c.amount) 0.0 allCoins
  assertMsg "Alice has 20.0 total" (total == 20.0)
  return ()

-- Test: Dispute resolved for provider (provider gets paid via locked coin)
testDisputeResolveForProvider : Script ()
testDisputeResolveForProvider = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 10.0

  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "coding", params = "{}"
      maxPrice = 5.0, slaTerms = defaultSLA, feeConfig = None

  offer <- submit bob do
    exerciseCmd request MakeOffer with price = 4.0, estimatedTimeMs = 10000

  escrow <- submit alice do
    exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  review <- submit bob do
    exerciseCmd escrow Deliver with
      resultHash = "sha256:code123"
      resultUrl = "https://results.cap/code"
      deliveredAt = t1

  dispute <- submit alice do
    exerciseCmd review Dispute with reason = "Not satisfied with quality", disputedAt = t1

  -- Consumer concedes → provider gets paid
  paymentCid <- submit alice do
    exerciseCmd dispute ResolveForProvider

  Some payment <- queryContractId bob paymentCid
  assertMsg "Bob gets 4.0" (payment.owner == bob)
  assertMsg "Payment is 4.0" (payment.amount == 4.0)
  return ()

-- ========== Deep Verification Tests ==========
-- These tests prove financial safety properties beyond happy-path coverage.

-- Helper: compute total supply (CAPCoin + LockedCAPCoin) across parties.
-- CAPCoin: owner is signatory, so query returns only owned coins (no double count).
-- LockedCAPCoin: signatory=originalOwner, observer=beneficiary, so both see it.
--   Filter by originalOwner==party to count each locked coin exactly once.
totalSupply : [Party] -> Script Decimal
totalSupply parties = do
  coinTotals <- forA parties (\p -> do
    coins <- query @CAPCoin p
    return (foldl (\acc (_, c) -> acc + c.amount) 0.0 coins))
  lockedTotals <- forA parties (\p -> do
    locked <- query @LockedCAPCoin p
    let owned = filter (\(_, c) -> c.originalOwner == p) locked
    return (foldl (\acc (_, c) -> acc + c.amount) 0.0 owned))
  return (foldl (+) 0.0 coinTotals + foldl (+) 0.0 lockedTotals)

-- ── Property 1: Token Conservation ──
-- Proves: sum(CAPCoin) + sum(LockedCAPCoin) is invariant through the full lifecycle.
-- Tests: mint → split → lock → escrow → deliver → approve → release
testTokenConservation_FullLifecycle : Script ()
testTokenConservation_FullLifecycle = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  let parties = [alice, bob]

  -- Mint
  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 100.0
  bobCoin <- submit bob do createCmd CAPCoin with owner = bob, amount = 50.0
  supply0 <- totalSupply parties
  assertMsg "Initial supply = 150" (supply0 == 150.0)

  -- Split
  (part1, _part2) <- submit alice do exerciseCmd aliceCoin Split with splitAmount = 30.0
  supply1 <- totalSupply parties
  assertMsg "After split supply = 150" (supply1 == 150.0)

  -- Lock
  lockedCid <- submit alice do exerciseCmd part1 Lock with beneficiary = bob
  supply2 <- totalSupply parties
  assertMsg "After lock supply = 150" (supply2 == 150.0)

  -- Release
  _released <- submitMulti [alice, bob] [] do exerciseCmd lockedCid ReleaseToBeneficiary
  supply3 <- totalSupply parties
  assertMsg "After release supply = 150" (supply3 == 150.0)

  return ()

-- Token conservation through cancel/refund path
testTokenConservation_CancelPath : Script ()
testTokenConservation_CancelPath = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  let parties = [alice, bob]

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 80.0
  supply0 <- totalSupply parties
  assertMsg "Initial = 80" (supply0 == 80.0)

  -- Full escrow lifecycle through cancellation
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}", maxPrice = 50.0, slaTerms = defaultSLA, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 25.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  supply1 <- totalSupply parties
  assertMsg "After escrow supply = 80" (supply1 == 80.0)

  -- Cancel → refund
  _refund <- submit alice do exerciseCmd escrow CancelEscrow
  supply2 <- totalSupply parties
  assertMsg "After cancel supply = 80" (supply2 == 80.0)

  return ()

-- Token conservation through dispute → ResolveForConsumer path
testTokenConservation_DisputeRefund : Script ()
testTokenConservation_DisputeRefund = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  let parties = [alice, bob]

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 60.0
  supply0 <- totalSupply parties
  assertMsg "Initial = 60" (supply0 == 60.0)

  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}", maxPrice = 10.0, slaTerms = defaultSLA, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 8.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  supply1 <- totalSupply parties
  assertMsg "After escrow = 60" (supply1 == 60.0)

  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "bad", resultUrl = "", deliveredAt = t1
  dispute <- submit alice do exerciseCmd review Dispute with reason = "bad quality", disputedAt = t1

  supply2 <- totalSupply parties
  assertMsg "During dispute = 60" (supply2 == 60.0)

  _refund <- submit bob do exerciseCmd dispute ResolveForConsumer
  supply3 <- totalSupply parties
  assertMsg "After dispute refund = 60" (supply3 == 60.0)

  return ()

-- Token conservation through dispute → ResolveForProvider path
testTokenConservation_DisputeRelease : Script ()
testTokenConservation_DisputeRelease = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  let parties = [alice, bob]

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 40.0
  supply0 <- totalSupply parties
  assertMsg "Initial = 40" (supply0 == 40.0)

  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}", maxPrice = 10.0, slaTerms = defaultSLA, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 5.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "ok", resultUrl = "", deliveredAt = t1
  dispute <- submit alice do exerciseCmd review Dispute with reason = "disputed", disputedAt = t1
  _payment <- submit alice do exerciseCmd dispute ResolveForProvider

  supply1 <- totalSupply parties
  assertMsg "After provider wins = 40" (supply1 == 40.0)

  return ()

-- ── Property 2: Authorization Boundary ──
-- Proves: unauthorized parties CANNOT exercise choices they shouldn't.

-- Third party cannot refund someone else's locked coin
testThirdPartyCannotRefund : Script ()
testThirdPartyCannotRefund = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  charlie <- allocateParty "Charlie"

  coin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  lockedCid <- submit alice do exerciseCmd coin Lock with beneficiary = bob

  -- Charlie (unrelated party) cannot refund
  submitMustFail charlie do exerciseCmd lockedCid Refund

  -- Bob (beneficiary) also cannot refund — only originalOwner can
  submitMustFail bob do exerciseCmd lockedCid Refund

  -- Alice (originalOwner) CAN refund
  _refund <- submit alice do exerciseCmd lockedCid Refund
  return ()

-- Third party cannot release someone else's locked coin
testThirdPartyCannotRelease : Script ()
testThirdPartyCannotRelease = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  charlie <- allocateParty "Charlie"

  coin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  lockedCid <- submit alice do exerciseCmd coin Lock with beneficiary = bob

  -- Charlie cannot release
  submitMustFail charlie do exerciseCmd lockedCid ReleaseToBeneficiary

  -- Alice alone cannot release (needs both)
  submitMustFail alice do exerciseCmd lockedCid ReleaseToBeneficiary

  -- Bob alone cannot release (needs both)
  submitMustFail bob do exerciseCmd lockedCid ReleaseToBeneficiary

  -- Only both together can release
  _released <- submitMulti [alice, bob] [] do exerciseCmd lockedCid ReleaseToBeneficiary
  return ()

-- Provider cannot cancel escrow (only consumer can)
testProviderCannotCancelEscrow : Script ()
testProviderCannotCancelEscrow = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}", maxPrice = 5.0, slaTerms = defaultSLA, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 2.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  -- Provider cannot cancel (only consumer can)
  submitMustFail bob do exerciseCmd escrow CancelEscrow

  -- Consumer CAN cancel
  _refund <- submit alice do exerciseCmd escrow CancelEscrow
  return ()

-- Consumer cannot abandon escrow (only provider can)
testConsumerCannotAbandonEscrow : Script ()
testConsumerCannotAbandonEscrow = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}", maxPrice = 5.0, slaTerms = defaultSLA, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 2.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  -- Consumer cannot abandon (only provider can)
  submitMustFail alice do exerciseCmd escrow AbandonEscrow

  -- Provider CAN abandon
  _refund <- submit bob do exerciseCmd escrow AbandonEscrow
  return ()

-- ── Property 3: State Integrity ──
-- Proves: no double-spend, no reuse, edge cases work correctly.

-- Cannot Lock an already-locked coin (consuming choice prevents reuse)
testNoDoubleLock : Script ()
testNoDoubleLock = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  charlie <- allocateParty "Charlie"

  coin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0

  -- First lock succeeds
  _lockedCid <- submit alice do exerciseCmd coin Lock with beneficiary = bob

  -- Second lock on same coin MUST fail (coin is consumed)
  submitMustFail alice do exerciseCmd coin Lock with beneficiary = charlie

  return ()

-- Cannot Refund an already-released coin
testNoRefundAfterRelease : Script ()
testNoRefundAfterRelease = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  coin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  lockedCid <- submit alice do exerciseCmd coin Lock with beneficiary = bob

  -- Release first
  _released <- submitMulti [alice, bob] [] do exerciseCmd lockedCid ReleaseToBeneficiary

  -- Refund on already-consumed LockedCAPCoin MUST fail
  submitMustFail alice do exerciseCmd lockedCid Refund

  return ()

-- Cannot Release an already-refunded coin
testNoReleaseAfterRefund : Script ()
testNoReleaseAfterRefund = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  coin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  lockedCid <- submit alice do exerciseCmd coin Lock with beneficiary = bob

  -- Refund first
  _refund <- submit alice do exerciseCmd lockedCid Refund

  -- Release on already-consumed LockedCAPCoin MUST fail
  submitMultiMustFail [alice, bob] [] do exerciseCmd lockedCid ReleaseToBeneficiary

  return ()

-- Exact amount payment (no split needed, direct lock)
testExactAmountPayment : Script ()
testExactAmountPayment = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  let parties = [alice, bob]

  -- Create coin with exact price amount
  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 3.0
  supply0 <- totalSupply parties

  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}", maxPrice = 5.0, slaTerms = defaultSLA, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 3.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  -- Alice should have NO change coins (exact payment)
  aliceCoins <- query @CAPCoin alice
  assertMsg "Alice has no change" (null aliceCoins)

  -- Supply preserved
  supply1 <- totalSupply parties
  assertMsg "Supply preserved after exact lock" (supply1 == supply0)

  -- Complete the flow
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "done", resultUrl = "", deliveredAt = t1
  (_payment, _) <- submit alice do exerciseCmd review QuickApprove

  supply2 <- totalSupply parties
  assertMsg "Supply preserved after release" (supply2 == supply0)

  -- Bob got exactly 3.0
  bobCoins <- query @CAPCoin bob
  let bobTotal = foldl (\acc (_, c) -> acc + c.amount) 0.0 bobCoins
  assertMsg "Bob received 3.0" (bobTotal == 3.0)

  return ()

-- Multiple concurrent escrows don't interfere with each other
testConcurrentEscrows : Script ()
testConcurrentEscrows = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  charlie <- allocateParty "Charlie"
  let parties = [alice, bob, charlie]

  -- Alice has one big coin, Bob and Charlie have coins too
  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 100.0
  _bobCoin <- submit bob do createCmd CAPCoin with owner = bob, amount = 50.0
  _charlieCoin <- submit charlie do createCmd CAPCoin with owner = charlie, amount = 50.0

  supply0 <- totalSupply parties
  assertMsg "Initial supply = 200" (supply0 == 200.0)

  -- Alice opens escrow with Bob (10 CAP)
  req1 <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "svc1", params = "{}", maxPrice = 20.0, slaTerms = defaultSLA, feeConfig = None
  offer1 <- submit bob do exerciseCmd req1 MakeOffer with price = 10.0, estimatedTimeMs = 5000

  -- Split first for escrow 1
  (pay1, remainder) <- submit alice do exerciseCmd aliceCoin Split with splitAmount = 10.0
  escrow1 <- submit alice do exerciseCmd offer1 AcceptOffer with paymentCid = pay1, acceptedAt = t0

  -- Alice opens escrow with Charlie (15 CAP) from remainder
  req2 <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = charlie
      capability = "svc2", params = "{}", maxPrice = 20.0, slaTerms = defaultSLA, feeConfig = None
  offer2 <- submit charlie do exerciseCmd req2 MakeOffer with price = 15.0, estimatedTimeMs = 5000
  escrow2 <- submit alice do exerciseCmd offer2 AcceptOffer with paymentCid = remainder, acceptedAt = t0

  supply1 <- totalSupply parties
  assertMsg "Two escrows, supply = 200" (supply1 == 200.0)

  -- Resolve escrow1: Bob delivers and gets paid
  review1 <- submit bob do exerciseCmd escrow1 Deliver with resultHash = "r1", resultUrl = "", deliveredAt = t1
  (_pay1Result, _) <- submit alice do exerciseCmd review1 QuickApprove

  -- Resolve escrow2: Alice cancels → refund
  _refund2 <- submit alice do exerciseCmd escrow2 CancelEscrow

  supply2 <- totalSupply parties
  assertMsg "After both resolved, supply = 200" (supply2 == 200.0)

  -- Verify final balances
  aliceCoins <- query @CAPCoin alice
  let aliceTotal = foldl (\acc (_, c) -> acc + c.amount) 0.0 aliceCoins
  assertMsg "Alice: 100 - 10(paid) = 90" (aliceTotal == 90.0)

  bobCoins <- query @CAPCoin bob
  let bobTotal = foldl (\acc (_, c) -> acc + c.amount) 0.0 bobCoins
  assertMsg "Bob: 50 + 10 = 60" (bobTotal == 60.0)

  charlieCoins <- query @CAPCoin charlie
  let charlieTotal = foldl (\acc (_, c) -> acc + c.amount) 0.0 charlieCoins
  assertMsg "Charlie: 50 (unchanged)" (charlieTotal == 50.0)

  return ()

-- Tiny amounts work correctly (precision test)
testTinyAmounts : Script ()
testTinyAmounts = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  let parties = [alice, bob]

  coin <- submit alice do createCmd CAPCoin with owner = alice, amount = 0.01
  supply0 <- totalSupply parties

  lockedCid <- submit alice do exerciseCmd coin Lock with beneficiary = bob
  supply1 <- totalSupply parties
  assertMsg "Tiny lock preserves supply" (supply1 == supply0)

  _released <- submitMulti [alice, bob] [] do exerciseCmd lockedCid ReleaseToBeneficiary
  supply2 <- totalSupply parties
  assertMsg "Tiny release preserves supply" (supply2 == supply0)

  return ()

-- ========== Phase 1: SLA Enforcement Tests ==========

-- Test: SplitRelease on LockedCAPCoin
testSplitRelease : Script ()
testSplitRelease = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  coin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0
  lockedCid <- submit alice do exerciseCmd coin Lock with beneficiary = bob

  (refundCid, payCid) <- submitMulti [alice, bob] [] do
    exerciseCmd lockedCid SplitRelease with beneficiaryAmount = 7.0

  Some refund <- queryContractId alice refundCid
  assertMsg "Refund is 3.0" (refund.owner == alice)
  assertMsg "Refund amount" (refund.amount == 3.0)

  Some pay <- queryContractId bob payCid
  assertMsg "Pay is bob" (pay.owner == bob)
  assertMsg "Pay amount" (pay.amount == 7.0)
  return ()

-- Test: On-time delivery — no penalty, full payment
testOnTimeDelivery : Script ()
testOnTimeDelivery = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0

  let sla = SLATerms with maxLatencyMs = 30000, penaltyRate = 0.10
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 10.0, slaTerms = sla, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 10.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  -- Deliver within deadline (t0 + 30s = well before t1 = 10s)
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "ok", resultUrl = "", deliveredAt = t1

  (payment, _) <- submit alice do exerciseCmd review ApproveAndPay with consumerRating = 5, consumerComment = "Great"

  Some coin <- queryContractId bob payment
  assertMsg "Full payment (no penalty)" (coin.amount == 10.0)
  return ()

-- Test: Late delivery with penalty — penalty applied
testLateDeliveryWithPenalty : Script ()
testLateDeliveryWithPenalty = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 10.0

  -- 5 second SLA with 10% penalty
  let sla = SLATerms with maxLatencyMs = 5000, penaltyRate = 0.10
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 10.0, slaTerms = sla, feeConfig = None
  offer <- submit bob do exerciseCmd request MakeOffer with price = 10.0, estimatedTimeMs = 3000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0

  -- deadline = t0 + 5s. Deliver at t1 = t0+10s (late!)
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "late", resultUrl = "", deliveredAt = t1

  (payment, _) <- submit alice do exerciseCmd review ApproveAndPay with consumerRating = 3, consumerComment = "Late"

  -- penalty = 10.0 * 0.10 = 1.0, net = 9.0
  Some coin <- queryContractId bob payment
  assertMsg "Net payment after penalty" (coin.amount == 9.0)

  -- Alice gets the 1.0 penalty refund
  aliceCoins <- query @CAPCoin alice
  let aliceTotal = foldl (\acc (_, c) -> acc + c.amount) 0.0 aliceCoins
  assertMsg "Alice got penalty refund" (aliceTotal == 1.0)
  return ()

