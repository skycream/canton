  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "ok", resultUrl = "", deliveredAt = t1
  (payment, _) <- submit alice do exerciseCmd review ApproveAndPay with consumerRating = 5, consumerComment = "Good"

  -- Bob gets full 100.0 (no fee)
