module Cap.Test where

import Daml.Script
import DA.Time (time)
import DA.Date (date, Month(..))
import Cap.Types
import Cap.Token
import Cap.Holding
import Cap.Agent
import Cap.Service
import Cap.Escrow
import Cap.Reputation
import Cap.Arbiter

-- Canonical times used across tests
t0 : Time
t0 = time (date 2025 Jan 1) 0 0 0

t1 : Time
t1 = time (date 2025 Jan 1) 0 0 10

t2 : Time
t2 = time (date 2025 Jan 1) 0 1 0

-- Full protocol flow test
testFullFlow : Script ()
testFullFlow = script do
  -- Parties
  registry <- allocateParty "Registry"
  alice <- allocateParty "Alice"      -- Consumer (research agent)
  bob <- allocateParty "Bob"          -- Provider (translation agent)
  charlie <- allocateParty "Charlie"  -- Competing agent (should see nothing)

  -- 1. Register agents
  submit alice do
    createCmd AgentProfile with
      registry, agent = alice
      name = "Research Agent"
      description = "AI research and analysis"
      capabilities = ["research", "analysis"]
      endpoint = "http://localhost:8001"

  submit bob do
    createCmd AgentProfile with
      registry, agent = bob
      name = "Translation Agent"
      description = "EN-KO translation"
      capabilities = ["translation"]
      endpoint = "http://localhost:8002"

  -- 2. Bob lists translation service
  submit bob do
    createCmd ServiceListing with
      registry, provider = bob
      capability = "translation"
      description = "EN to KO, 99% accuracy"
      basePrice = 0.05

  -- 3. Registry can discover all agents
  allAgents <- query @AgentProfile registry
  assertMsg "Registry sees all agents" (length allAgents == 2)

  allListings <- query @ServiceListing registry
  assertMsg "Registry sees listings" (length allListings == 1)

  -- 4. Mint coins
  aliceCoin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 100.0

  -- 5. Alice requests translation
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice
      provider = bob
      capability = "translation"
      params = "{\"text\": \"Hello world\", \"target\": \"ko\"}"
      maxPrice = 1.0
      slaTerms = defaultSLA, feeConfig = None

  -- 6. Bob makes offer
  offer <- submit bob do
    exerciseCmd request MakeOffer with
      price = 0.05
      estimatedTimeMs = 3000

  -- 7. Alice accepts → Escrow (Split + Lock)
  escrow <- submit alice do
    exerciseCmd offer AcceptOffer with
      paymentCid = aliceCoin
      acceptedAt = t0

  -- 8. Bob delivers
  review <- submit bob do
    exerciseCmd escrow Deliver with
      resultHash = "sha256:abc123"
      resultUrl = "https://results.cap/001"
      deliveredAt = t1

  -- 9. Alice approves and pays with rating
  (bobPayment, _) <- submit alice do
    exerciseCmd review ApproveAndPay with
      consumerRating = 5
      consumerComment = "Fast and accurate"

  -- 10. Verify Bob got paid
  Some bobCoin <- queryContractId bob bobPayment
  assertMsg "Bob received 0.05" (bobCoin.amount == 0.05)

  -- 11. Verify Alice got change (100 - 0.05 = 99.95)
  aliceCoins <- query @CAPCoin alice
  let aliceTotal = foldl (\acc (_, c) -> acc + c.amount) 0.0 aliceCoins
  assertMsg "Alice has 99.95" (aliceTotal == 99.95)

  -- 12. Privacy: Charlie sees nothing about Alice-Bob deal
  charlieCoins <- query @CAPCoin charlie
  assertMsg "Charlie sees no coins" (null charlieCoins)

  charlieRequests <- query @ServiceRequest charlie
  assertMsg "Charlie sees no requests" (null charlieRequests)

  charlieEscrows <- query @Escrow charlie
  assertMsg "Charlie sees no escrows" (null charlieEscrows)

  charlieRatings <- query @Rating charlie
  assertMsg "Charlie sees no ratings" (null charlieRatings)

  return ()

-- Test: Provider declines request
testDecline : Script ()
testDecline = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  aliceCoin <- submit alice do
    createCmd CAPCoin with owner = alice, amount = 50.0

  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "translation", params = "{}"
      maxPrice = 1.0, slaTerms = defaultSLA, feeConfig = None

  submit bob do exerciseCmd request DeclineRequest

  coins <- query @CAPCoin alice
  assertMsg "Alice still has coin" (length coins == 1)
  return ()

-- Test: Consumer withdraws request
testWithdraw : Script ()
testWithdraw = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "translation", params = "{}"
      maxPrice = 1.0, slaTerms = defaultSLA, feeConfig = None

  submit alice do exerciseCmd request WithdrawRequest

  requests <- query @ServiceRequest alice
  assertMsg "No active requests" (null requests)
  return ()

-- Test: Consumer rejects offer
testRejectOffer : Script ()
testRejectOffer = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "translation", params = "{}"
      maxPrice = 1.0, slaTerms = defaultSLA, feeConfig = None

  offer <- submit bob do
