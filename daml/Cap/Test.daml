-- Test: Late delivery + fee: penalty first, then fee on net payment
testFeeWithPenalty : Script ()
testFeeWithPenalty = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  treasury <- allocateParty "Treasury"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 100.0
  -- 5s SLA, 10% penalty, 2% fee
  let sla = SLATerms with maxLatencyMs = 5000, penaltyRate = 0.10
  let fc = Some (FeeConfig with feeRate = 0.02, treasury)
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 100.0, slaTerms = sla, feeConfig = fc
  offer <- submit bob do exerciseCmd request MakeOffer with price = 100.0, estimatedTimeMs = 3000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0
  -- Late delivery (t1 = t0+10s > deadline = t0+5s)
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "late", resultUrl = "", deliveredAt = t1
  (payment, _) <- submit alice do exerciseCmd review ApproveAndPay with consumerRating = 3, consumerComment = "Late"

  -- Penalty: 100 * 0.10 = 10 → net = 90
  -- Fee: 90 * 0.02 = 1.8 → Bob gets 88.2
  Some coin <- queryContractId bob payment
  assertMsg "Bob gets 88.2 after penalty+fee" (coin.amount == 88.2)

  -- Alice gets penalty refund = 10.0
  aliceCoins <- query @CAPCoin alice
  let aliceTotal = foldl (\acc (_, c) -> acc + c.amount) 0.0 aliceCoins
  assertMsg "Alice got 10.0 penalty refund" (aliceTotal == 10.0)

  -- FeeTransfer = 1.8
  feeTransfers <- query @FeeTransfer treasury
  let (_, ft) = headNote "fee" feeTransfers
  assertMsg "Fee is 1.8" (ft.amount == 1.8)
  return ()

headNote : Text -> [a] -> a
headNote msg [] = error msg
headNote _ (x :: _) = x
