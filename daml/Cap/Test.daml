-- ========== Phase 4: Protocol Fee Tests ==========

-- Test: Fee on settlement — 2% fee deducted, FeeTransfer created
testFeeOnSettlement : Script ()
testFeeOnSettlement = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  treasury <- allocateParty "Treasury"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 100.0
  let fc = Some (FeeConfig with feeRate = 0.02, treasury)
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 100.0, slaTerms = defaultSLA, feeConfig = fc
  offer <- submit bob do exerciseCmd request MakeOffer with price = 100.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "ok", resultUrl = "", deliveredAt = t1
  (payment, _) <- submit alice do exerciseCmd review ApproveAndPay with consumerRating = 5, consumerComment = "Good"

  -- Bob gets 98.0 (100 - 2% fee)
  Some coin <- queryContractId bob payment
  assertMsg "Bob gets 98.0 after fee" (coin.amount == 98.0)

  -- FeeTransfer exists for treasury
  feeTransfers <- query @FeeTransfer treasury
  assertMsg "One fee transfer" (length feeTransfers == 1)
  let (_, ft) = headNote "fee" feeTransfers
  assertMsg "Fee amount is 2.0" (ft.amount == 2.0)
  assertMsg "Fee payer is bob" (ft.payer == bob)
  return ()

-- Test: Treasury collects fee → CAPCoin(treasury)
testFeeCollection : Script ()
testFeeCollection = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  treasury <- allocateParty "Treasury"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 50.0
  let fc = Some (FeeConfig with feeRate = 0.10, treasury)
  request <- submit alice do
    createCmd ServiceRequest with
      consumer = alice, provider = bob
      capability = "test", params = "{}"
      maxPrice = 50.0, slaTerms = defaultSLA, feeConfig = fc
  offer <- submit bob do exerciseCmd request MakeOffer with price = 50.0, estimatedTimeMs = 5000
  escrow <- submit alice do exerciseCmd offer AcceptOffer with paymentCid = aliceCoin, acceptedAt = t0
  review <- submit bob do exerciseCmd escrow Deliver with resultHash = "ok", resultUrl = "", deliveredAt = t1
  _ <- submit alice do exerciseCmd review ApproveAndPay with consumerRating = 5, consumerComment = "Good"

  -- Treasury collects fee
  feeTransfers <- query @FeeTransfer treasury
  let (ftCid, _) = headNote "fee" feeTransfers
  treasuryCoin <- submit treasury do exerciseCmd ftCid CollectFee

  Some coin <- queryContractId treasury treasuryCoin
  assertMsg "Treasury got 5.0" (coin.amount == 5.0)
  assertMsg "Treasury owns coin" (coin.owner == treasury)
  return ()

-- Test: No fee when feeConfig = None
testNoFeeWhenNone : Script ()
testNoFeeWhenNone = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  treasury <- allocateParty "Treasury"

  aliceCoin <- submit alice do createCmd CAPCoin with owner = alice, amount = 100.0
